# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (SERVER ONLY - never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used when generating invite links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage bucket name for event images (public so the browser can read it)
NEXT_PUBLIC_SUPABASE_IMAGE_BUCKET=event-images
